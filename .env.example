PORT=4000
NODE_ENV=production

# Preferido en Railway / producción
DATABASE_URL=

# Fallback si no usas DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=control_enfunde

# Pool y timeouts
DB_POOL_MAX=3
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_SATURATION_COOLDOWN_MS=5000
AUTH_SESSION_CACHE_TTL_MS=30000
DB_APP_NAME=control-finca-backend

# Seguridad / auth
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_SEGURO
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=

# Integraciones y entorno
OPENWEATHER_API_KEY=
CORS_ORIGINS=http://localhost:5173,https://control-finca.vercel.app
DEBUG_HEALTH_TOKEN=
SALT_ROUNDS=10
LOG_LEVEL=info
